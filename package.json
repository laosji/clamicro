{
  "name": "clamicro",
  "version": "2.18.0",
  "description": "Watch Claude Code from your phone and approve what it wants to run. LAN-direct, zero dependencies.",
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "approval",
    "monitor",
    "mobile"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "clamicro": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "install.mjs",
    "server.mjs",
    "src/",
    "ui/",
    "bin/",
    "docs/",
    "!docs/images",
    "!docs/index.html",
    "!docs/.nojekyll",
    "!docs/CNAME",
    "!docs/zh",
    "!docs/site.css",
    "!docs/site.js",
    "plugins/",
    "!plugins/*/dev",
    "README.md",
    "README.zh-CN.md",
    "NOTES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "postinstall": "node -e \"console.log('\\n  Clamicro 已下载。执行 npx clamicro install 完成安装。\\n')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laosji/clamicro.git"
  },
  "bugs": {
    "url": "https://github.com/laosji/clamicro/issues"
  },
  "homepage": "https://github.com/laosji/clamicro#readme",
  "author": "laosji"
}
